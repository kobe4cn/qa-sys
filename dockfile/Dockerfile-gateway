ARG DEV_IMAGE=qa-project-dev:v1.0
FROM ${DEV_IMAGE} AS builder

LABEL org.opencontainers.image.authors="kevin"

ENV LANG=C.UTF-8

WORKDIR /app

COPY . .

RUN cargo build --release

FROM debian:bookworm-slim

WORKDIR /app

ENV QA_CONFIG_DIR=/app/config
VOLUME ${QA_CONFIG_DIR}

EXPOSE 8090
EXPOSE 1338

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        net-tools \
        vim \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p "$QA_CONFIG_DIR"

COPY --from=builder /app/target/release/gateway /app/qa-gateway

CMD ["/app/qa-gateway"]
